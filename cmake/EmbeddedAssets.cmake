# =============================================================================
# embedded assets: per-set sections + per-executable linker script (page alignment for madvise)
# =============================================================================

# animation sets with embedded assets (src/embedded_assets/<set>, src/image_loader/<set>)
# each set gets its own group of sections (.assets.<set>.*) inside the .bongocat.assets block,
# see include/embedded_assets/assets.h
set(
  BONGOCAT_ASSET_SETS
  bongocat
  min_dm
  dm
  dm20
  dmx
  dmc
  pen
  pen20
  dmall
  pkmn
  pmd
  ms_agent
  misc
)

# bongocat_target_assets_segment(<executable> <loaders-lib>...)
#
# Generates ${CMAKE_BINARY_DIR}/assets_segment/<executable>.ld and links <executable> with it.
# The animation sets are taken from the assets_<set>[_loader|_feature|_interface] entries in the
# INTERFACE_LINK_LIBRARIES of the given (INTERFACE) loader libraries, call it AFTER all their target_link_libraries().
#
# Layout (page alignment for safe madvise(MADV_DONTNEED)):
#   .bongocat.assets  sprite load/reload  -> animation::unload_assets_readonly_sections()
#     one page-aligned group per linked set (_bongocat_start/stop_assets_<set>) + "common"
#   .bongocat.config  config load/reload  -> unload_config_readonly_sections()
function(bongocat_target_assets_segment target)
  # collect the linked animation sets
  set(found_sets "")
  foreach(loaders_lib IN LISTS ARGN)
    get_target_property(loaders_libs ${loaders_lib} INTERFACE_LINK_LIBRARIES)
    if(NOT loaders_libs)
      continue()
    endif()
    foreach(item IN LISTS loaders_libs)
      if(NOT item MATCHES "^assets_")
        continue()
      endif()
      string(REGEX REPLACE "_(loader|feature|interface)$" "" asset_set "${item}")
      string(REGEX REPLACE "^assets_(more_)?" "" asset_set "${asset_set}")
      list(APPEND found_sets ${asset_set})
    endforeach()
  endforeach()
  # keep the BONGOCAT_ASSET_SETS order, ignore non-set libraries (image, base_dm, custom, ...)
  set(linked_sets "")
  foreach(asset_set IN LISTS BONGOCAT_ASSET_SETS)
    if(asset_set IN_LIST found_sets)
      list(APPEND linked_sets ${asset_set})
    endif()
  endforeach()
  message(STATUS "Assets segment for ${target}: ${linked_sets}")

  set(ld "")
  string(
    APPEND ld
    "/* Page alignment for safe madvise(MADV_DONTNEED), generated by CMakeLists.txt for ${target}\n"
    " * animation sets: ${linked_sets}\n"
    [=[
 *
 * One page-aligned block per load phase, evicted as a whole after the phase:
 *   .bongocat.assets  sprite load/reload  -> animation::unload_assets_readonly_sections()
 *   .bongocat.config  config load/reload  -> unload_config_readonly_sections()
 * Inside .bongocat.assets every animation set is its own page-aligned group (_bongocat_start/stop_assets_<set>),
 * so a set's images, settings, evolution data, dims and sizes stay together.
 *
 * Only READ-ONLY data WITHOUT relocations (no pointers) may go in here, see include/embedded_assets/assets.h.
 * MADV_DONTNEED on relocated (dirty) pages would re-read the unrelocated file bytes.
 */
SECTIONS
{
  . = ALIGN(CONSTANT(MAXPAGESIZE));
  .bongocat.assets :
  {
    _bongocat_start_assets = .;
]=]
  )
  foreach(asset_set IN LISTS linked_sets)
    string(
      APPEND ld
      "    /* ${asset_set} */\n"
      "    . = ALIGN(CONSTANT(MAXPAGESIZE));\n"
      "    _bongocat_start_assets_${asset_set} = .;\n"
      "    KEEP(*(.assets.${asset_set}.images))\n"
      "    KEEP(*(.assets.${asset_set}.image_sizes))\n"
      "    KEEP(*(.assets.${asset_set}.dims))\n"
      "    KEEP(*(.assets.${asset_set}.sprite_settings))\n"
    )
    # @NOTE(10): sets without evolution data get no evol sub range
    if(NOT asset_set MATCHES "^(bongocat|misc|ms_agent)$")
      string(
        APPEND ld
        "    . = ALIGN(CONSTANT(MAXPAGESIZE));\n"
        "    _bongocat_start_assets_${asset_set}_evol_data = .;\n"
        "    KEEP(*(.assets.${asset_set}.evol_data))\n"
        "    . = ALIGN(CONSTANT(MAXPAGESIZE));\n"
        "    _bongocat_stop_assets_${asset_set}_evol_data = .;\n"
      )
    endif()
    if(asset_set STREQUAL "common")
      # safety net: sets linked only transitively (not found above) still end up in the evicted block
      string(
        APPEND ld
        "    /* not listed sets (linked transitively), keep them inside the evicted block */\n"
        "    KEEP(*(.assets.*.images))\n"
        "    KEEP(*(.assets.*.image_sizes))\n"
        "    KEEP(*(.assets.*.dims))\n"
        "    KEEP(*(.assets.*.sprite_settings))\n"
      )
      # @NOTE(10): sets without evolution data get no evol sub range
      if(NOT asset_set MATCHES "^(bongocat|misc|ms_agent)$")
        string(
          APPEND ld
          "    . = ALIGN(CONSTANT(MAXPAGESIZE));\n"
          "    _bongocat_start_assets_${asset_set}_evol_data = .;\n"
          "    KEEP(*(.assets.*.evol_data))\n"
          "    . = ALIGN(CONSTANT(MAXPAGESIZE));\n"
          "    _bongocat_stop_assets_${asset_set}_evol_data = .;\n"
        )
      endif()
    endif()
    string(APPEND ld "    . = ALIGN(CONSTANT(MAXPAGESIZE));\n" "    _bongocat_stop_assets_${asset_set} = .;\n")
  endforeach()
  # sets NOT linked into this executable are not mentioned at all,
  # the code references _bongocat_start/stop_assets_<set> as weak symbols (null when absent),
  # see BONGOCAT_ASSETS_DECLARE_SET_RANGE in include/embedded_assets/assets.h
  string(
    APPEND ld
    [=[
    _bongocat_stop_assets = .;
  }

  . = ALIGN(CONSTANT(MAXPAGESIZE));
  .bongocat.config :
  {
    _bongocat_start_config = .;
    KEEP(*(.config.str))
    . = ALIGN(CONSTANT(MAXPAGESIZE));
    _bongocat_stop_config = .;
  }
}
INSERT AFTER .rodata;
]=]
  )

  set(ld_file ${CMAKE_BINARY_DIR}/assets_segment/${target}.ld)
  # only rewritten when the content changes (no needless relinks)
  file(CONFIGURE OUTPUT ${ld_file} CONTENT "${ld}" @ONLY)
  target_link_options(${target} PRIVATE -Wl,-T,${ld_file})
  set_property(TARGET ${target} APPEND PROPERTY LINK_DEPENDS ${ld_file})
endfunction()
