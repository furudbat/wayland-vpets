# Bongo Cat + V-Pets configuration
# Edit these values to customize your wpet overlay
#
# Save this file to: ~/.config/bongocat/bongocat.conf
# Run with: wpets-all --watch-config


## INPUT
# No keyboard is used unless one is configured here (or --default-devices is passed).
# `wpets-all --list-devices` prints lines you can paste below.
# keyboard_device: Input device path (can be repeated)
#keyboard_device=/dev/input/event4
#keyboard_device=/dev/input/by-id/usb-My_Keyboard-event-kbd
# keyboard_name: Add every device whose name contains this text (can be repeated)
#keyboard_name=Keyboard
# hotplug_scan_interval: Rescan for new input devices, in seconds (0 = scan once at startup)
#hotplug_scan_interval=30


## OVERLAY
# overlay_height: Height of the overlay bar
overlay_height=120
# overlay_position: "top" or "bottom"
overlay_position=bottom
# overlay_layer: "overlay", "top", "bottom" or "background"
#   top = above windows
#   overlay = above everything (also fullscreen)
#overlay_layer=top
# overlay_opacity: Background opacity
overlay_opacity=0

# monitor: Show the pet only on this monitor
# If not set or not found, the first monitor is used
#monitor=HDMI-A-1
# screen_width: Override the detected screen width in pixels (0 = auto-detect)
#screen_width=0
# disable_fullscreen_hide: Keep the overlay visible over fullscreen windows
#disable_fullscreen_hide=0


## SPRITE
# animation_name: Sprite name (case sensitive)
#   Bongocat:  "bongocat"
#   Digimon:   "Agumon", "Greymon", "metal_greymon", "dm20:Agumon", "dmc:Agumon", "dm:Gabumon", ...
#   MS Agent:  "Clippy", "ms_agent:Links", ...
#   Pokémon:   "Bulbasaur", "Pikachu", "pkmn:Charizard", ...
#   Misc:      "neko"
#   Custom:    "custom" (see below)
animation_name=bongocat

# cat_height: Height of the pet in pixels
cat_height=110

# cat_align: Horizontal alignment in the bar: "center", "left" or "right"
cat_align=center
# cat_x_offset: Horizontal offset in pixels
cat_x_offset=0
# cat_y_offset: Vertical offset in pixels
cat_y_offset=0

# mirror_x: Flip the pet horizontally
mirror_x=0
# mirror_y: Flip the pet vertically
mirror_y=0

# invert_color: Invert colors (Digimon sprites are black by default, useful for dark mode)
invert_color=0

# enable_antialiasing: Smooth scaling (bilinear), recommended off for pixel sprites
enable_antialiasing=1

# random: Pick a random sprite from the set of animation_name (dm, pkmn, ms_agent, ...) on start
random=0
# random_on_reload: Pick a new random sprite on config reload (needs random=1)
random_on_reload=1


## ANIMATION
# fps: Render frame rate
fps=60
# animation_speed: Duration of each frame in milliseconds (0 = use fps)
animation_speed=200
# idle_animation: Show idle animate
idle_animation=0
# idle_frame: Frame shown while idle
#   Bongocat: 0 = both paws up, 1 = left paw down, 2 = right paw down, 3 = both paws down
#   Digimon / MS Agent: 0 = idle frame 1, 1 = idle frame 2
idle_frame=0

# Bongocat only
# keypress_duration: How long a paw stays down after a keypress, in milliseconds
keypress_duration=100
# enable_hand_mapping: When enabled: 1 = left keys -> left paw, right keys -> right paw
enable_hand_mapping=1

# input_fps: Input polling rate (0 = use fps)
#input_fps=0

# DEPRECATED: use animation_speed and idle_animation
#test_animation_duration=0
#test_animation_interval=0


## SLEEP
# enable_scheduled_sleep: Sleep between sleep_begin and sleep_end (24h, hh:mm)
enable_scheduled_sleep=0
sleep_begin=22:00
sleep_end=06:00
# idle_sleep_timeout: Fall asleep after this many seconds without input (0 = disabled)
idle_sleep_timeout=0


## HAPPY
# happy_kpm: Keystrokes per minute that trigger the happy animation (0 = disabled)
happy_kpm=400


#ä CPU
# update_rate: How often to check CPU usage, in milliseconds (0 = disabled)
#update_rate=2000
# cpu_threshold: Average CPU usage (%) that triggers the working animation (0 = disabled)
#cpu_threshold=90
# cpu_running_factor: Play the running animation instead and speed it up linearly
#   cpu_running_factor is at 100% CPU (0 = disabled)
#cpu_running_factor=5.0


## AUDIO (PipeWire) (BUILD REQUIRED) (experimental)
# audio: React to audio playing on an output sink
#audio=0
# audio_sink: PipeWire sink to listen to, see `pactl list short sinks` (empty = default sink)
#audio_sink=
# audio_happy_peak: Fraction of visualizer bars (0.0-1.0) that triggers happy (0 = disabled)
#audio_happy_peak=0.6
# audio_fps: Audio update rate (0 = use fps)
#audio_fps=0


## MOVEMENT
# movement_speed: Pixels per move animation (0 = disabled), needs animation_speed
movement_speed=0
# movement_radius: Moving area, radius from the pet's position in pixels (0 = disabled)
movement_radius=960
# movement_wait_factor: Pause after moving: movement_speed * movement_wait_factor
#movement_wait_factor=5.1
# enable_movement_debug: Draw the moving area
enable_movement_debug=0


## EVOLUTION (Digimon and Pokémon)
# evolution: Evolve after a fixed amount of time
#   none:    disabled
#   normal:  time since the last evolution
#   program: time since program start
#   uptime:  time since boot
evolution=none
# evolution_speed_factor: Speed multiplier for evolution time
#evolution_speed_factor=1.0


## CUSTOM SPRITE SHEET
#animation_name=custom
#custom_sprite_sheet_filename=./examples/custom-sprite-sheets/neko.png
# Frames per row (0 = state not used)
#custom_idle_frames=2
#custom_boring_frames=2
#custom_writing_frames=2
#custom_happy_frames=2
#custom_asleep_frames=2
#custom_sleep_frames=2
#custom_wake_up_frames=1
#custom_working_frames=2
#custom_moving_frames=2
# Optional: start/end frames, e.g. custom_start_writing_frames, custom_end_moving_frames, ...
# Optional: row of each state (1-based, default: in order), e.g. custom_idle_row=1
# Optional: frame size padding in pixels
#padding_x=0
#padding_y=0


## DEBUG
# enable_debug: Print debug messages
enable_debug=0
